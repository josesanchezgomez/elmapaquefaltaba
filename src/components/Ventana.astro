---
/**
 * La ventana de José: su cara, como en sus vídeos, y «Escúchame medio minuto».
 *
 * En el HTML va DETRÁS de las acciones de la portada, que es el orden de Nacho
 * (texto/DECISIONES-v7.md, bloque 1: titular, tres párrafos y acciones; debajo,
 * el clip). Quien usa lector de pantalla o tabulador llega antes al titular.
 *   · Móvil y tableta: ahí se ve, en su sitio del texto: la foto y, a su lado,
 *     quién es y el botón de escuchar.
 *   · Escritorio (desde 1000): se coloca sobre el hueco que el mapa le guarda
 *     arriba a la derecha (MapaPortada.astro), como en sus vídeos.
 *
 * La foto lleva alt="": el nombre del enlace ya es lo que dice su pie («José
 * @el_mapa_que_faltaba Escúchame medio minuto»).
 */
import { FOTOS, MARCA, VIDEOS } from '../consts';

const video = VIDEOS[0];
/* Su voz en la portada: medio minuto de su vídeo, no los 16 minutos enteros.
   El tramo 14:19–14:54 dice «si repites patrones, hay una explicación… a mí me
   ha costado toda una vida de prueba y error». Para quien llega frío, medio
   minuto se escucha; un cuarto de hora, no. */
const VOZ = { inicio: 859, fin: 894 };
---

<a
  class="ventana"
  href={`https://www.youtube.com/watch?v=${video.id}&t=${VOZ.inicio}s`}
  data-reproducir={video.id}
  data-titulo={video.titulo}
  data-inicio={VOZ.inicio}
  data-fin={VOZ.fin}
  aria-haspopup="dialog"
  target="_blank" rel="noopener noreferrer"
>
  <span class="ventana__foto" data-cara>
    <img
      src={FOTOS.portada.src}
      width={FOTOS.portada.ancho}
      height={FOTOS.portada.alto}
      alt=""
      decoding="async"
      fetchpriority="high"
    />
  </span>
  <span class="ventana__pie">
    <span class="ventana__nombre">{MARCA.persona}</span>
    <span class="ventana__usuario">{MARCA.usuario}</span>
    <span class="ventana__accion">
      <span class="ventana__play" aria-hidden="true">
        <svg viewBox="0 0 10 12"><path d="M0 0l10 6-10 6z" fill="currentColor"></path></svg>
      </span>
      Escúchame medio minuto
    </span>
  </span>
</a>

<style>
  /* Móvil y tableta: la foto y, a su lado, el pie. */
  .ventana {
    display: flex;
    align-items: center;
    gap: 18px;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
  }

  .ventana__foto {
    display: block;
    flex: none;
    /* 96 px a 320 (el @usuario, 150 px, cabe al lado), 117 a 390. */
    width: clamp(96px, 30vw, 132px);
    overflow: hidden;
    border-radius: var(--radio);
    box-shadow:
      0 0 0 1.5px var(--color-tinta),
      0 0 0 5px var(--banda);
    transition: box-shadow var(--t-rapida);
  }

  .ventana__foto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .ventana:hover .ventana__foto {
    box-shadow:
      0 0 0 2px var(--color-acento),
      0 0 0 5px var(--banda);
  }

  .ventana__pie {
    display: block;
    min-width: 0;
  }

  .ventana__nombre {
    display: block;
    font: 600 var(--t-ui) / 1.25 var(--font-cuerpo);
    color: var(--color-tinta);
  }

  .ventana__usuario {
    display: block;
    font-size: var(--t-nota);
    line-height: 1.3;
    color: var(--color-tinta-2);
  }

  /* El mismo lenguaje que «Ver el vídeo» en «Empieza por escuchar»: un círculo
     turquesa con el play y el texto turquesa, sin fondo. */
  .ventana__accion {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 6px;
    font: 600 var(--t-ui) / 1.2 var(--font-cuerpo);
    color: var(--color-acento);
    /* «Escúchame / medio minuto», nunca «minuto» solo. */
    text-wrap: balance;
  }

  .ventana__play {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-oro);
    color: var(--color-sobre-oro);
  }

  .ventana__play svg {
    width: 9px;
    height: 11px;
    margin-left: 2px;
  }

  /* Escritorio: en su hueco del mapa, con el pie debajo de la foto. La
     posición la da .portada (index.astro), que es su contenedor. */
  @media (min-width: 1000px) {
    .ventana {
      position: absolute;
      z-index: 1;
      display: block;
    }
    .ventana__foto {
      width: 100%;
    }
    .ventana__pie {
      margin-top: 12px;
    }
    .ventana__accion {
      margin-top: 2px;
    }
  }

  /* Portátil (1000–1279): el mapa del móvil (390 × 420) a la izquierda, con
     --mapa-w de ancho; la ventana ocupa su x 218–374 y baja 8 px desde arriba. */
  @media (min-width: 1000px) and (max-width: 1279.98px) {
    .ventana {
      top: calc(24px + 8px);
      left: calc(24px + var(--mapa-w, 560px) * 201 / 390);
      width: calc(var(--mapa-w, 560px) * 156 / 390);
    }
  }

  /* Escritorio ancho: la ventana escala con el mapa (212 px a 1440), así nunca
     pisa sus rótulos. */
  @media (min-width: 1280px) {
    .ventana {
      top: 40px;
      right: calc(var(--mapa-derecha, 0px) + var(--mapa-ancho, 749px) * 0.09);
      width: calc(var(--mapa-ancho, 749px) * 0.283);
    }
  }
</style>
