---
/**
 * El signo de la marca: una senda coral que sale y vuelve al mismo punto, y
 * una sola, turquesa, que baja hacia dentro. Es el mapa de la portada en
 * pequeño. Se usa en la cabecera; el favicon (Base.astro) es el mismo dibujo.
 */
interface Props {
  tamano?: number;
  class?: string;
}
const { tamano = 28, class: clase } = Astro.props;
---

<svg
  class:list={['signo', clase]}
  width={tamano}
  height={tamano}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M13 15c2.4-4.2 5.2-8.6 9.4-8.9 3.6-.3 5.4 3.4 3.1 5.8-2.6 2.7-7.8 3.1-12.5 3.1"
    fill="none"
    stroke="#96A08B"
    stroke-width="2"
    stroke-linecap="round"
    stroke-dasharray="2.8 2.3"></path>
  <path
    d="M13 15c-.4 3.6 2.6 5.2 1.2 8.4-1.2 2.7-5 3.3-6.2 6.6"
    fill="none"
    stroke="#A88A52"
    stroke-width="2.6"
    stroke-linecap="round"></path>
  <circle cx="13" cy="15" r="2.9" fill="#1C2A25"></circle>
</svg>
