---
/**
 * Preguntas frecuentes PLEGABLES, pregunta a pregunta (José, 30/09: «¿no
 * puede ser colapsada?»). Es el <details> del navegador: se abre y se cierra
 * con el ratón, el dedo o el teclado, sin JavaScript, y el lector de pantalla
 * anuncia si está abierta o cerrada. El texto sigue en el HTML (lo encuentran
 * los buscadores y verificar-texto).
 *
 * La cabecera de la sección, centrada; la lista, en la columna de lectura.
 * Cada pregunta es un h3 dentro de su <summary>: quien navega por titulares
 * las encuentra.
 */
import { atarCortas, negritas } from '../lib/texto';

interface Props {
  /** La respuesta puede tener varios párrafos. */
  lista: { pregunta: string; respuesta: string | readonly string[] }[];
  titulo?: string;
}
const { lista, titulo = 'Preguntas frecuentes' } = Astro.props;
---

<div class="frecuentes">
  <h2 class="frecuentes__titulo" set:html={atarCortas(titulo)} />
  <div class="frecuentes__lista">
    {
      lista.map((f) => (
        <details class="frecuentes__par">
          <summary>
            <h3 class="frecuentes__pregunta">{f.pregunta}</h3>
            <span class="frecuentes__signo" aria-hidden="true" />
          </summary>
          <div class="frecuentes__respuesta">
            {(typeof f.respuesta === 'string' ? [f.respuesta] : f.respuesta).map((p) => (
              <p set:html={negritas(p)} />
            ))}
          </div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .frecuentes__titulo {
    max-width: 820px;
    margin: 0 auto var(--tras-titulo);
    text-align: center;
  }

  .frecuentes__lista {
    max-width: 820px;
    margin-inline: auto;
    border-bottom: 1px solid var(--color-filete-fuerte);
  }

  .frecuentes__par {
    border-top: 1px solid var(--color-filete-fuerte);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline-offset: 4px;
  }

  .frecuentes__pregunta {
    text-wrap: pretty;
  }

  /* El signo: una cruz dentro de un círculo que se vuelve un «menos». */
  .frecuentes__signo {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-oro-hondo);
  }

  .frecuentes__signo::before,
  .frecuentes__signo::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.6px;
    margin: -0.8px 0 0 -6px;
    background: var(--color-oliva);
    transition: transform var(--t-media) ease;
  }

  .frecuentes__signo::after {
    transform: rotate(90deg);
  }

  details[open] .frecuentes__signo::after {
    transform: rotate(0deg);
  }

  summary:hover .frecuentes__signo {
    box-shadow: inset 0 0 0 1.6px var(--color-oliva);
  }

  .frecuentes__respuesta {
    max-width: 64ch;
    padding: 0 52px 26px 0;
  }

  .frecuentes__respuesta p + p {
    margin-top: 12px;
  }

  @media (max-width: 599.98px) {
    .frecuentes__respuesta {
      padding-right: 0;
    }
  }
</style>
