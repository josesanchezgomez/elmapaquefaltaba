---
/**
 * Los vídeos del canal, por fachada.
 *
 * Hasta que se pulsa no se carga nada de YouTube (ni scripts, ni cookies, ni
 * la miniatura): el póster es un fotograma del propio vídeo servido desde la
 * web. Al pulsar, el vídeo entra en su sitio desde youtube-nocookie. Sin
 * JavaScript, el enlace abre el vídeo en YouTube. Un vídeo que no deja
 * insertarse (incrustable: false en consts.ts) se abre siempre en YouTube.
 *
 * El «Ver el vídeo» va DEBAJO del fotograma: sobre su cara no va nada. Tiene
 * el mismo lenguaje que «Escúchame medio minuto» (Ventana.astro): un círculo
 * turquesa con el play y el texto turquesa, sin fondo. El relleno turquesa a
 * lo ancho queda para la acción de la página. El enlace es toda la tarjeta.
 * Sin reproducción automática al cargar y sin subtítulos quemados.
 */
import { VIDEOS } from '../consts';

interface Props {
  /** Solo estos vídeos (por id); sin él, todos (la portada). */
  ids?: string[];
}
const { ids } = Astro.props;
const lista = ids ? VIDEOS.filter((v) => ids.includes(v.id)) : VIDEOS;
---

<ul class="videos">
  {
    lista.map((v) => (
      <li>
        <figure class="video" data-video={v.incrustable === false ? undefined : v.id} data-titulo={v.titulo}>
          <a
            class="video__boton"
            href={`https://www.youtube.com/watch?v=${v.id}`}
            aria-label={v.incrustable === false ? `Ver en YouTube: ${v.titulo}` : `Ver el vídeo: ${v.titulo}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="video__marco" data-cara data-cara-zona={v.cara}>
              <img
                src={v.poster}
                srcset={`${v.posterMovil} 640w, ${v.poster} 1280w`}
                sizes="(min-width: 1000px) 576px, calc(100vw - 54px)"
                alt=""
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="video__play" aria-hidden="true">
              <span class="video__ico">
                <svg viewBox="0 0 10 12"><path d="M0 0l10 6-10 6z" fill="currentColor" /></svg>
              </span>
              {v.incrustable === false ? 'Ver en YouTube' : 'Ver el vídeo'}
            </span>
          </a>
          <figcaption>
            <span class="video__titulo">{v.titulo}</span>
            <span class="video__duracion">{v.duracion}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .videos {
    display: grid;
    gap: 36px;
    margin-top: 26px;
  }

  /* v6: la tarjeta del blog de la plantilla, blanca y con sombra. */
  .video {
    height: 100%;
    overflow: hidden;
    border-radius: var(--radio);
    background: #fff;
    box-shadow: var(--sombra);
  }

  .video__play,
  figcaption {
    padding-inline: 24px;
  }

  figcaption {
    padding-bottom: 24px;
  }

  .video__boton {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .video__marco {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0;
    background: var(--color-tinta);
    box-shadow: none;
    transition: box-shadow var(--t-rapida);
  }

  .video__marco img,
  .video__marco :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .video__boton:hover .video__marco img {
    opacity: 0.9;
  }

  .video__play {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 16px;
    color: var(--color-acento);
    font: 600 var(--t-ui) / 1.2 var(--font-cuerpo);
  }

  .video__ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-oro);
    color: var(--color-sobre-oro);
    transition: background-color var(--t-rapida);
  }

  .video__boton:hover .video__ico {
    background: var(--color-oro-vivo);
  }

  .video__ico svg {
    width: 9px;
    height: 11px;
    margin-left: 2px;
  }

  /* El título y, debajo, siempre en su línea, la duración: los dos pies
     casan aunque un título ocupe un renglón y el otro dos. */
  figcaption {
    margin-top: 6px;
  }

  .video__titulo {
    display: block;
    font: 600 var(--t-3) / 1.3 var(--font-cuerpo);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .video__duracion {
    display: block;
    margin-top: 4px;
    font-size: var(--t-nota);
    color: var(--color-tinta-2);
  }

  @media (min-width: 1000px) {
    .videos {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((figura) => {
    const enlace = figura.querySelector<HTMLAnchorElement>('.video__boton');
    const marco = enlace?.querySelector<HTMLElement>('.video__marco');
    enlace?.addEventListener('click', (e) => {
      if (!marco) return;
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${figura.dataset.video}?autoplay=1&rel=0`;
      iframe.title = figura.dataset.titulo || 'Vídeo del canal';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      // El mismo marco se queda en su sitio: el fotograma sale y entra el vídeo.
      marco.replaceChildren(iframe);
      enlace.replaceWith(marco);
      iframe.focus();
    });
  });
</script>
