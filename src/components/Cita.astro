---
/**
 * Las citas de Jung. Van como nota al margen, en la cursiva de la letra de
 * titulares: citar bien es una credencial, pero no es el protagonista.
 * El texto y el autor salen literales de contenido.ts.
 */
interface Props {
  texto: string;
  autor: string;
  class?: string;
}
const { texto, autor, class: clase } = Astro.props;
---

<figure class:list={['cita', clase]}>
  <blockquote><p>{texto}</p></blockquote>
  <figcaption>{autor}</figcaption>
</figure>

<style>
  .cita {
    max-width: 30ch;
  }

  /* La voz citada: Instrument Serif itálica. */
  blockquote p {
    font: italic 400 clamp(21px, 19.25px + 0.449vw, 25px) / 1.3 var(--font-display);
    letter-spacing: 0;
    color: var(--color-tinta);
  }

  figcaption {
    margin-top: 8px;
    font-size: var(--t-nota);
    color: var(--color-tinta-2);
  }
</style>
