---
/**
 * ACOMPAÑAMIENTO GRUPAL · v6. Texto: GRUPAL en contenido.ts, literal de la
 * versión definitiva de Nacho (01/10; DECISIONES-v17.md). Sustituye entera a
 * la primera versión de la mañana.
 *
 * El recorrido que pide Nacho: dolor reconocible → identificación → autoridad
 * por la historia de José → método y experiencia grupal → beneficios →
 * objeciones → conversación privada. Con las piezas del 1 a 1 (v6):
 *   1 · Cabecera: la foto de José en el mirador (suya: nada de stock ni de
 *       supuestos grupos), las migas y la pregunta. El titular va a la
 *       derecha, hacia donde mira José.
 *   2 · Hero: el antetítulo, la entrada, qué es (con la raya lima, como la
 *       ficha del 1 a 1), el botón y su línea de privado, junto a José
 *       subiendo un sendero (la camisa verde, solo en la portada). · gris
 *   3 · Identificación: las cinco situaciones y su cierre.        · blanco
 *   4 · La historia de José: su tarjeta, como «No acompaño esto…». · gris
 *   5 · Qué hace diferente a los encuentros: la entrada y los cuatro
 *       elementos en tarjetas con icono, sin números (no son cuatro
 *       sesiones ni un temario).                                   · blanco
 *   6 · Beneficios: la lista en su tarjeta blanca (para no repetir la forma
 *       del bloque siguiente) y su cierre.                         · gris
 *   7 · Puede encajar contigo si…                                  · blanco
 *   8 · Cómo empezamos: cuatro pasos y «Quiero hablar con José».   · gris
 *   9 · Preguntas frecuentes (plegables).                          · blanco
 *  10 · La carta, con su propio mensaje de WhatsApp.               · gris
 *
 * Todos los botones bajan a la carta de esta página: siempre se habla en
 * privado antes de incorporar a nadie.
 *
 * SEO: título y descripción (SEO.grupal), imagen al compartir (OG.grupal) y,
 * en los datos estructurados, el servicio y sus preguntas, tal como se leen.
 */
import Base from '../layouts/Base.astro';
import FotoFondo from '../components/FotoFondo.astro';
import Icono from '../components/Icono.astro';
import Frecuentes from '../components/Frecuentes.astro';
import Carta from '../components/Carta.astro';
import { ACCION, GRUPAL as G, SEO } from '../contenido';
import { OG } from '../lib/og';
import { migas, preguntas, servicio } from '../lib/esquema';
import { FOTOS } from '../consts';
import { atarCortas, negritas, esFuerte } from '../lib/texto';

// Un icono por elemento de los encuentros, en su orden.
const ICONOS = ['bucle', 'encuentro', 'lupa', 'camino'] as const;
---

<Base
  titulo={SEO.grupal.titulo}
  descripcion={SEO.grupal.descripcion}
  og={OG.grupal}
  esquema={(site, ruta) => [migas(site, ruta, G.nombre), servicio(site, ruta, 'grupal'), preguntas(site, ruta, G.frecuentes.lista)]}
  barra={{ texto: ACCION.caso, href: '#contacto', ocultarSobre: '#contacto' }}
>
  {/* 1 · La cabecera con la foto de José y las migas */}
  <section class="heroe heroe--pagina heroe--derecha" aria-labelledby="t-grupal">
    <FotoFondo foto="grupal" />
    <div class="envoltorio">
      <div class="heroe__bloque">
        <nav aria-label="Estás en">
          <ol class="migas">
            <li><a href="/">Inicio</a></li>
            <li aria-current="page">{G.nombre}</li>
          </ol>
        </nav>
        <h1 id="t-grupal" set:html={atarCortas(G.titulo)} />
      </div>
    </div>
  </section>

  {/* 2 · El hero: la entrada, qué es y el botón, junto a su foto */}
  <section class="banda banda--salvia" aria-label={G.nombre}>
    <div class="envoltorio partida partida--al-reves">
      <figure class="partida__foto foto-marco">
        <img src={FOTOS.sendero.src} width={FOTOS.sendero.ancho} height={FOTOS.sendero.alto} alt={FOTOS.sendero.alt} loading="lazy" decoding="async" />
      </figure>
      <div class="partida__texto">
        <p class="antetitulo grupal-antetitulo">{G.antetitulo}</p>
        {G.parrafos.map((p) => <p class:list={{ fuerte: esFuerte(p) }} set:html={negritas(p)} />)}
        <p class="ficha">{G.presentacion}</p>
        <div class="acciones" data-accion-principal>
          <a class="boton" href="#contacto">{G.accion}</a>
          <p class="quien-firma">{G.bajoAccion}</p>
        </div>
      </div>
    </div>
  </section>

  {/* 3 · Identificación con el dolor */}
  <section class="banda banda--papel" aria-labelledby="t-dolor">
    <div class="envoltorio">
      <div class="cabeza-seccion">
        <h2 id="t-dolor" set:html={atarCortas(G.dolor.titulo)} />
        <p>{G.dolor.entrada}</p>
      </div>
      <ul class="puntos">
        {G.dolor.lineas.map((l) => <li>{l}</li>)}
      </ul>
      <p class="fuerte remate" set:html={negritas(G.dolor.cierre)} />
    </div>
  </section>

  {/* 4 · La historia de José: su tarjeta, como la autoridad del 1 a 1 */}
  <section class="banda banda--salvia" aria-labelledby="t-historia">
    <div class="envoltorio">
      <div class="caja grupal-historia">
        <h2 id="t-historia" class="raya" set:html={atarCortas(G.historia.titulo)} />
        <div class="columna">
          {G.historia.parrafos.map((p) => <p class:list={{ fuerte: esFuerte(p) }} set:html={negritas(p)} />)}
        </div>
      </div>
    </div>
  </section>

  {/* 5 · Qué hace diferente a los encuentros: los cuatro elementos */}
  <section class="banda banda--papel" aria-labelledby="t-diferente">
    <div class="envoltorio">
      <div class="cabeza-seccion">
        <h2 id="t-diferente" set:html={atarCortas(G.diferente.titulo)} />
        {G.diferente.parrafos.map((p) => <p>{p}</p>)}
      </div>
      <div class="tarjetas tarjetas--4">
        {
          G.diferente.elementos.map((e, i) => (
            <article class="tarjeta">
              <span class="circulo"><Icono nombre={ICONOS[i] ?? 'camino'} /></span>
              <h3>{e.nombre}</h3>
              <p>{e.texto}</p>
            </article>
          ))
        }
      </div>
      <p class="fuerte remate" set:html={negritas(G.diferente.cierre)} />
    </div>
  </section>

  {/* 6 · Beneficios y transformación posible */}
  <section class="banda banda--salvia" aria-labelledby="t-beneficios">
    <div class="envoltorio">
      <div class="cabeza-seccion">
        <h2 id="t-beneficios" set:html={atarCortas(G.beneficios.titulo)} />
        <p>{G.beneficios.entrada}</p>
      </div>
      <div class="caja grupal-beneficios">
        <p class="grupal-beneficios__antes">{G.beneficios.antesLista}</p>
        <ul class="puntos puntos--una">
          {G.beneficios.lineas.map((l) => <li>{l}</li>)}
        </ul>
      </div>
      <p class="fuerte remate" set:html={negritas(G.beneficios.cierre)} />
    </div>
  </section>

  {/* 7 · Puede encajar contigo si… */}
  <section class="banda banda--papel" aria-labelledby="t-encaja">
    <div class="envoltorio">
      <div class="cabeza-seccion">
        <h2 id="t-encaja" set:html={atarCortas(G.encaja.titulo)} />
      </div>
      <ul class="puntos">
        {G.encaja.lineas.map((l) => <li>{l}</li>)}
      </ul>
      <p class="fuerte remate" set:html={negritas(G.encaja.cierre)} />
    </div>
  </section>

  {/* 8 · Cómo empezamos: los pasos en sus círculos y el botón */}
  <section class="banda banda--salvia" aria-labelledby="t-proceso">
    <div class="envoltorio">
      <div class="cabeza-seccion">
        <h2 id="t-proceso" set:html={atarCortas(G.proceso.titulo)} />
      </div>
      <ol class="pasos grupal-pasos">
        {
          G.proceso.pasos.map((p) => (
            <li>
              <h3>{p.nombre}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
      <p class="grupal-proceso__accion"><a class="boton" href="#contacto">{G.proceso.accion}</a></p>
    </div>
  </section>

  {/* 9 · Preguntas frecuentes */}
  <section class="banda banda--papel" aria-label={G.frecuentes.titulo}>
    <div class="envoltorio">
      <Frecuentes lista={G.frecuentes.lista} titulo={G.frecuentes.titulo} />
    </div>
  </section>

  {/* 10 · La carta */}
  <section class="banda banda--salvia admision" id="contacto">
    <div class="envoltorio admision__dentro">
      <Carta
        asunto="Cuéntame tu caso — acompañamiento grupal"
        titulo={G.contacto.titulo}
        entrada={G.contacto.entrada}
        boton={G.contacto.boton}
        mensajeWhatsApp={G.contacto.mensajeWhatsApp}
      />
    </div>
  </section>
</Base>

<style>
  .foto-marco {
    overflow: hidden;
    border-radius: var(--radio);
    box-shadow: var(--sombra);
  }

  .partida__foto img {
    aspect-ratio: 4 / 5;
  }

  /* El antetítulo es largo: a la izquierda, como el texto, y en dos líneas si
     hace falta. */
  .grupal-antetitulo {
    text-align: left;
    text-wrap: balance;
  }

  /* Qué es: con la raya lima a la izquierda, como la ficha del 1 a 1. */
  .ficha {
    max-width: 52ch;
    margin-top: 26px !important;
    padding-left: 16px;
    border-left: 3px solid var(--color-oro);
    color: var(--color-tinta);
    font-weight: 600;
    line-height: 1.6;
  }

  .quien-firma {
    margin-top: 14px;
    font-size: var(--t-nota);
    line-height: 1.35;
    text-wrap: balance;
  }

  @media (min-width: 600px) {
    .acciones .quien-firma {
      margin-top: 0;
    }
  }

  /* El remate de una sección, centrado bajo la lista o las tarjetas. */
  .remate {
    max-width: 62ch;
    margin: 40px auto 0;
    text-align: center;
    text-wrap: balance;
  }

  /* La historia: la tarjeta blanca, como la autoridad del 1 a 1. */
  .grupal-historia {
    max-width: 900px;
    margin-inline: auto;
    text-align: center;
  }

  .grupal-historia .columna {
    margin-top: 28px;
    text-align: left;
  }

  .grupal-historia p {
    color: var(--color-tinta-2);
  }

  .grupal-historia .fuerte,
  .grupal-historia :global(strong) {
    color: var(--color-tinta);
  }

  /* Los beneficios: la lista en una columna, dentro de su tarjeta. */
  .grupal-beneficios {
    max-width: 820px;
    margin-inline: auto;
  }

  .grupal-beneficios__antes {
    color: var(--color-tinta);
    font-weight: 600;
  }

  .grupal-beneficios .puntos {
    grid-template-columns: 1fr;
    gap: 4px;
    margin-top: 12px;
  }

  .grupal-pasos {
    max-width: 1100px;
    margin-inline: auto;
  }

  @media (min-width: 1000px) {
    .grupal-pasos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 28px;
    }
  }

  .grupal-proceso__accion {
    margin-top: 44px;
    text-align: center;
  }
</style>
