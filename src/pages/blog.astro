---
/**
 * El blog (06/10, borrador a la espera de José): la cabecera con su foto y,
 * debajo, los artículos del más nuevo al más antiguo. Cada tarjeta lleva la
 * fecha, los minutos de lectura, el título, el resumen y «Leer el artículo».
 */
import Base from '../layouts/Base.astro';
import FotoFondo from '../components/FotoFondo.astro';
import { ACCION, BLOG, SEO } from '../contenido';
import { migas } from '../lib/esquema';
import { articulos, fechaLarga, minutos } from '../lib/blog';
import { atarCortas } from '../lib/texto';

const lista = await articulos();
---

<Base
  titulo={SEO.blog.titulo}
  descripcion={SEO.blog.descripcion}
  esquema={(site, ruta) => [migas(site, ruta, BLOG.rotulo)]}
  barra={{ texto: ACCION.caso, href: '/#contacto' }}
>
  <section class="heroe heroe--pagina" aria-labelledby="t-blog">
    <FotoFondo foto="blog" />
    <div class="envoltorio">
      <div class="heroe__bloque">
        <nav aria-label="Estás en">
          <ol class="migas">
            <li><a href="/">Inicio</a></li>
            <li aria-current="page">{BLOG.rotulo}</li>
          </ol>
        </nav>
        <h1 id="t-blog">{BLOG.titulo}</h1>
        <p class="blog-entrada">{BLOG.entrada}</p>
      </div>
    </div>
  </section>

  <section class="banda banda--papel" aria-label={BLOG.rotulo}>
    <div class="envoltorio">
      <ul class="blog-lista">
        {
          lista.map((a) => (
            <li>
              <article class="blog-tarjeta">
                <p class="blog-meta">
                  <time datetime={a.data.fecha.toISOString().slice(0, 10)}>{fechaLarga(a.data.fecha)}</time>
                  <span aria-hidden="true">·</span>
                  <span>
                    {minutos(a.body)} {BLOG.minutos}
                  </span>
                </p>
                <h2>
                  <a href={`/blog/${a.id}`} set:html={atarCortas(a.data.titulo)} />
                </h2>
                <p class="blog-tarjeta__resumen">{a.data.resumen}</p>
                <p>
                  <a class="enlace" href={`/blog/${a.id}`}>
                    {BLOG.leer}
                  </a>
                </p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .blog-entrada {
    max-width: 46ch;
    margin-top: 14px;
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--t-destacado, 18px);
    line-height: 1.6;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }

  .blog-lista {
    display: grid;
    gap: 28px;
    max-width: 820px;
    margin-inline: auto;
    padding: 0;
    list-style: none;
  }

  .blog-tarjeta {
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radio);
    background: #fff;
    box-shadow: var(--sombra);
  }

  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    color: var(--color-oro-texto);
    font: 600 12px / 1.6 var(--font-cuerpo);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .blog-tarjeta h2 {
    margin-top: 10px;
    font-size: clamp(22px, 18px + 1vw, 30px);
    line-height: 1.25;
  }

  .blog-tarjeta h2 a {
    color: var(--color-tinta);
    text-decoration: none;
  }

  .blog-tarjeta h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-oro);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .blog-tarjeta__resumen {
    margin-top: 12px;
  }

  .blog-tarjeta p:last-child {
    margin-top: 8px;
  }
</style>
