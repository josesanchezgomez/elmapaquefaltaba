---
/**
 * GRACIAS · después de la carta («Cuéntame tu caso»), desde la portada o
 * desde el acompañamiento 1 a 1. La lista de espera de la escuela tiene su
 * propia página: /gracias-lista, con el mismo molde.
 *
 * El momento más frágil del recorrido es el segundo de después de escribirle
 * a un desconocido lo que no te deja estar en paz. Esta página confirma que
 * ha llegado, dice qué va a pasar y da una cosa que hacer hoy. Y un siguiente
 * paso: la comunidad, para no esperar solo; va solo su botón, tras un filete
 * (no hay frase de puente en el texto v7, y Claude no la escribe). Va fuera de
 * los buscadores: solo tiene sentido después de escribir.
 */
import Base from '../layouts/Base.astro';
import { CAMINOS, GRACIAS as G } from '../contenido';
import { MARCA } from '../consts';

/** El botón a la comunidad lleva la misma acción que su puerta en la portada. */
const comunidad = CAMINOS.lista.find((c) => c.ruta === '/comunidad')!;
---

<Base titulo={`${G.titulo.replace(/\.$/, '')} · ${MARCA.nombre}`} descripcion={G.entrada} sinFirma noIndexar>
  <section class="banda banda--salvia gracias" aria-labelledby="t-gracias">
    <div class="envoltorio gracias__texto">
      <h1 id="t-gracias">{G.titulo}</h1>
      <p class="gracias__entrada">{G.entrada}</p>
      <p class="gracias__cuerpo">{G.cuerpo}</p>
      <p class="gracias__firma">{G.firma}</p>

      <div class="gracias__siguiente">
        <a class="boton boton--linea" href={comunidad.ruta}>{comunidad.accion}</a>
      </div>
      <p class="gracias__volver"><a class="enlace" href="/">Volver a la portada</a></p>
    </div>
  </section>
</Base>

<style>
  /* EL MOLDE DE LAS DOS PÁGINAS DE GRACIAS (el mismo en gracias-lista.astro). */
  .gracias {
    padding-bottom: 72px;
  }

  .gracias__texto > * {
    max-width: 34ch;
  }

  /* El h1 en su paso de siempre: la confirmación es información, no una
     cumbre. Debajo, la entradilla en el paso ENUNCIADO (500). */
  .gracias__entrada {
    margin-top: var(--tras-titulo);
    font: 400 var(--t-enunciado) / 1.15 var(--font-display);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .gracias__cuerpo {
    margin-top: 24px;
  }

  .gracias__firma {
    margin-top: 28px;
    font: italic 400 var(--t-destacado) / 1.4 var(--font-display);
    color: var(--color-tinta-2);
    /* «El mapa está en ti. / Y yo te acompaño.»: nunca «te acompaño.» suelto. */
    text-wrap: balance;
  }

  .gracias__siguiente {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--color-filete-fuerte);
  }

  /* Pantalla baja (navegador de Instagram, iPhone pequeño): menos aire, para que el siguiente paso siga a la vista. */
  @media (max-width: 599.98px) and (max-height: 720px) {
    .gracias__siguiente {
      margin-top: 28px;
      padding-top: 20px;
    }
  }

  .gracias__volver {
    margin-top: 20px;
  }

  @media (min-width: 1000px) {
    .gracias {
      padding: 64px max(var(--lado), (100% - var(--ancho)) / 2) 96px;
    }
    /* El texto arranca donde el de las demás páginas (sin centrarse en su celda). */
    .gracias__texto {
      margin-inline: 0;
      padding-inline: 0;
    }
    /* Lo que se lee, a la medida de lectura (a 34ch quedaban 40 caracteres
       por renglón y un vacío en el centro de la pantalla). */
    .gracias__texto > .gracias__cuerpo,
    .gracias__texto > .gracias__siguiente {
      max-width: var(--medida);
    }
  }
</style>
