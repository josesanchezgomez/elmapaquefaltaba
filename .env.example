# Copia este fichero como .env y rellena los valores.
# ⛔ El .env NUNCA se sube al repositorio.

# Clave pública de Web3Forms, que es quien entrega el formulario al correo.
# Se saca gratis en https://web3forms.com dando un correo.
PUBLIC_WEB3FORMS_KEY=

# El WhatsApp personal de José para el botón de la carta: número completo en
# formato internacional, sin «+», espacios ni guiones (por ejemplo, 34600111222).
# No va en el repositorio ni escrito en la web (contra el spam). Vacío = sin botón.
WHATSAPP_PERSONAL=
